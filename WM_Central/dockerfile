FROM python:3.11-slim

# Directorio raíz dentro del contenedor
WORKDIR /app

# Copiamos solo los requirements primero
COPY WM_Central/requirements.txt ./WM_Central/
RUN pip install --no-cache-dir -r WM_Central/requirements.txt

# Copiamos las carpetas necesarias
COPY common/ ./common/
COPY WM_Central/ ./WM_Central/

# Nos movemos a la carpeta de la central para ejecutar el código
WORKDIR /app/WM_Central

# Le decimos a Python que busque módulos (como common) desde /app
ENV PYTHONPATH=/app

EXPOSE 8080
ENTRYPOINT ["python", "-u", "WM_Central.py"]
