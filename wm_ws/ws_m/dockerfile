FROM python:3.11-slim

WORKDIR /app

COPY common/ ./common/
COPY wm_ws/ws_m/ ./wm_ws/ws_m/

WORKDIR /app/wm_ws/ws_m

ENV PYTHONPATH=/app
# Dentro de un contenedor, 127.0.0.1 solo lo ve ese contenedor: el Engine
# (otro contenedor) no podría conectar. Escuchamos en todas las interfaces.
ENV MONITOR_IP=0.0.0.0

ENTRYPOINT ["python", "-u", "WM_WS_M.py"]